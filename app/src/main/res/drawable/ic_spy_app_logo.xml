<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark Premium Background Card -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#251642"
                android:centerColor="#160E27"
                android:endColor="#0B0714"
                android:type="linear" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1.5dp"
                android:color="#4A2A82" />
        </shape>
    </item>

    <!-- Spy Vector Icon Centered -->
    <item
        android:drawable="@drawable/ic_spy_hat_glasses"
        android:left="16dp"
        android:right="16dp"
        android:top="16dp"
        android:bottom="16dp" />
</layer-list>