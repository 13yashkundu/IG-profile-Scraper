<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_post_grid_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1.5dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/card_bg_dark"
    app:cardCornerRadius="4dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    tools:layout_height="120dp"
    tools:layout_width="120dp">

    <!-- 1:1 Square Ratio Frame for Instagram Grid -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp">

        <!-- Post Thumbnail Image -->
        <ImageView
            android:id="@+id/img_post_grid_thumbnail"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="Grid Post Thumbnail"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_spy_hat_glasses"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Top Right Post Type Badge (Carousel / Video Indicator) -->
        <ImageView
            android:id="@+id/img_post_type_badge"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="6dp"
            android:contentDescription="Post Type"
            android:src="@drawable/ic_carousel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/white" />

        <!-- Bottom Likes Overlay Badge -->
        <LinearLayout
            android:id="@+id/likes_overlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="#60000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            app:layout_constraintBottom_toBottomOf="@+id/img_post_grid_thumbnail"
            app:layout_constraintEnd_toEndOf="@+id/img_post_grid_thumbnail"
            app:layout_constraintStart_toStartOf="@+id/img_post_grid_thumbnail">

            <TextView
                android:id="@+id/tv_post_likes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="❤️ 12.4k"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>