<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_history_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_dark_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:padding="12dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/profile_picture"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:padding="3dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_spy_hat_glasses"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CircleImageView"
        app:strokeColor="@color/accent_purple_bright"
        app:strokeWidth="2.5dp" />

    <!-- Username & Profile Details Container -->
    <LinearLayout
        android:id="@+id/user_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tag_and_action_container"
        app:layout_constraintStart_toEndOf="@+id/profile_picture"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Username -->
        <TextView
            android:id="@+id/username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:maxLines="1"
            android:text="instagram"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <!-- Full Name / Subtitle Details -->
        <TextView
            android:id="@+id/full_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Instagram"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Category Pill Tag & Delete Action -->
    <LinearLayout
        android:id="@+id/tag_and_action_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

<!--        &lt;!&ndash; Scraped Type Badge (Profile, Stories, Posts, etc.) &ndash;&gt;-->
<!--        <TextView-->
<!--            android:id="@+id/tv_category_tag"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_marginEnd="10dp"-->
<!--            android:background="@drawable/bg_pro_badge"-->
<!--            android:fontFamily="sans-serif-medium"-->
<!--            android:paddingHorizontal="10dp"-->
<!--            android:paddingVertical="4dp"-->
<!--            android:text="Profile"-->
<!--            android:textColor="@color/accent_purple_bright"-->
<!--            android:textSize="11sp" />-->

        <!-- Remove / Close Button -->
        <ImageView
            android:id="@+id/btn_delete_history"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="Remove search item"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_hint" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>