<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_premium_dark_gradient"
    android:padding="20dp"
    tools:context=".Home_fragment">

    <ImageView
        android:id="@+id/img_app_logo"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="Spy Icon"
        android:src="@drawable/ic_spy_hat_glasses"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/title_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:gravity="start"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/img_app_logo"
        app:layout_constraintStart_toEndOf="@+id/img_app_logo"
        app:layout_constraintTop_toTopOf="@+id/img_app_logo">

        <!-- Dual-Tone Brand Typography -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_app_title_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:text="Scrap"
                android:textColor="@color/white"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/tv_app_title_accent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.04"
                android:text="er"
                android:textColor="@color/accent_purple_bright"
                android:textSize="26sp" />

            <!-- Glowing Purple Accent Dot -->
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_purple_accent_gradient" />
        </LinearLayout>

        <!-- Subtitle Badge with Spaced Lettering -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.18"
            android:text="STEALTH ENGINE"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Metrics Tiles Container -->
    <LinearLayout
        android:id="@+id/metrics_tiles_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_container">

        <!-- Tile 1 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dark_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ 0.4s"
                android:textColor="@color/accent_purple_bright"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Fast Extract"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tile 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dark_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 100%"
                android:textColor="#4ADE80"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Anonymous"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tile 3 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dark_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Multi"
                android:textColor="#60A5FA"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Engine"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>


    <!-- Search Bar Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/search_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_search_input"
        android:paddingStart="16dp"
        android:paddingEnd="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/metrics_tiles_container">

        <!-- Search Input -->
        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:background="@null"
            android:hint="Enter Instagram username..."
            android:inputType="textPersonName"
            android:textColor="@color/white"
            android:textColorHint="@color/text_hint"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/search_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Gradient Action Button -->
        <FrameLayout
            android:id="@+id/search_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_purple_accent_gradient"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Search"
                android:src="@drawable/search_icon"
                app:tint="@color/white" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- Boxy Category Cards Scroll Container (Profile, Stories, Posts, Reels, Highlights) -->
    <HorizontalScrollView
        android:id="@+id/boxy_cards_scroll_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_bar">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/card_profile"
                style="@style/CategoryChip">
                <ImageView style="@style/CategoryChipIcon" android:src="@drawable/ic_box_profile" />
                <TextView style="@style/CategoryChipLabel" android:text="Profile" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_stories"
                style="@style/CategoryChip">
                <ImageView style="@style/CategoryChipIcon" android:src="@drawable/ic_box_stories" />
                <TextView style="@style/CategoryChipLabel" android:text="Stories" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_posts"
                style="@style/CategoryChip">
                <ImageView style="@style/CategoryChipIcon" android:src="@drawable/ic_box_posts" />
                <TextView style="@style/CategoryChipLabel" android:text="Posts" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_reels"
                style="@style/CategoryChip">
                <ImageView style="@style/CategoryChipIcon" android:src="@drawable/ic_box_reels" />
                <TextView style="@style/CategoryChipLabel" android:text="Reels" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_highlights"
                style="@style/CategoryChip"
                android:layout_marginEnd="0dp">
                <ImageView style="@style/CategoryChipIcon" android:src="@drawable/ic_box_highlights" />
                <TextView style="@style/CategoryChipLabel" android:text="Highlights" />
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>



    <LinearLayout
        android:id="@+id/history_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/boxy_cards_scroll_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp"
        android:visibility="visible"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/search_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recent Searches"
                android:textColor="@color/text_primary"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:text="See all"
                android:visibility="gone"
                android:textColor="@color/accent_purple_bright" />
        </LinearLayout>

        <!-- Empty Search View Included Below Heading -->
        <include
            android:id="@+id/empty_search"
            layout="@layout/fragment_empty_search_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />


    </LinearLayout>




</androidx.constraintlayout.widget.ConstraintLayout>