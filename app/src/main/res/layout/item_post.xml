<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_post_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/card_bg_dark"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke_dark"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. Post Header Bar (Avatar + Username + Options) -->
        <LinearLayout
            android:id="@+id/post_header_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- User Avatar -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/img_post_user_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="User Avatar"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_spy_hat_glasses"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                app:strokeColor="@color/accent_purple_bright"
                app:strokeWidth="1.5dp" />

            <!-- Username & Location -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_post_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="instagram"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_post_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Original Audio"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Download Quick Button -->
            <ImageView
                android:id="@+id/btn_post_quick_download"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Download Post"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_download"
                app:tint="@color/accent_purple_bright" />

        </LinearLayout>

        <!-- 2. Main Post Photo / Media View (1:1 Ratio) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/img_post_media"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:contentDescription="Post Media"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_spy_hat_glasses"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Carousel / Video Type Badge -->
            <ImageView
                android:id="@+id/img_post_type_badge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_margin="10dp"
                android:contentDescription="Media Type"
                android:src="@drawable/ic_carousel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 3. Action Buttons Bar (Like, Comment, Save) -->
        <LinearLayout
            android:id="@+id/post_actions_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <!-- Like Heart -->
            <ImageView
                android:id="@+id/btn_like_post"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Like"
                android:src="@drawable/ic_heart"
                app:tint="@color/white" />

            <!-- Comment -->
            <ImageView
                android:id="@+id/btn_comment_post"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"
                android:contentDescription="Comment"
                android:src="@drawable/ic_comment"
                app:tint="@color/white" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Save Bookmark -->
            <ImageView
                android:id="@+id/btn_bookmark_post"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Bookmark"
                android:src="@drawable/ic_bookmark"
                app:tint="@color/white" />

        </LinearLayout>

        <!-- 4. Likes & Caption Details -->
        <LinearLayout
            android:id="@+id/post_details_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="12dp">

            <!-- Likes Count -->
            <TextView
                android:id="@+id/tv_post_likes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="124,582 likes"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <!-- Caption -->
            <TextView
                android:id="@+id/tv_post_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:text="instagram Discover what's new on Instagram 📸✨ Bringing you closer to the people &amp; things you love."
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <!-- Comments Count -->
            <TextView
                android:id="@+id/tv_post_comments_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="View all 1,280 comments"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Time Ago -->
            <TextView
                android:id="@+id/tv_post_time_ago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="2 HOURS AGO"
                android:textColor="@color/text_hint"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>